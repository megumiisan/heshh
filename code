def get_hash(key, size):
    h = 0
    for char in key:
        h = (h * 31 + ord(char)) % size
    return h

def insert(table, key, name, group, size):
    print(f"\n Добавление: {key} ({name}, {group})")
    index = get_hash(key, size)
    print(f"1. Вычислен хеш: {index}")

    start_index = index

    while table[index] is not None:
        if table[index][0] == key:
            print(f"   Ключ {key} уже есть в ячейке {index}. Обновляем данные.")
            table[index] = (key, name, group)
            return

        print(f"   Ячейка {index} занята ключом '{table[index][0]}'. Ищем следующую...")
        index = (index + 1) % size

        if index == start_index:
            print("   Ошибка: Таблица переполнена!")
            return

    table[index] = (key, name, group)
    print(f"2. Запись помещена в ячейку {index}")
